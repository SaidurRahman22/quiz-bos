# Copy to .env and fill in your MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Quiz_boss
PORT=4000

# Secret used to sign login tokens (JWT) — REQUIRED. The server refuses to start
# without a value of at least 32 characters (there is no insecure fallback).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: how long a login stays valid (default 1d)
JWT_EXPIRES_IN=1d

# CORS: comma-separated list of allowed front-end origins (e.g. https://quiz-bos.vercel.app).
# REQUIRED in production so your deployed frontend can call the API.
# Leave unset to DENY all cross-origin requests.
CORS_ORIGIN=

# --- Cloud hosts can instead provide a single connection URL ---
# DATABASE_URL=mysql://user:password@host:port/dbname
# Set DB_SSL=true for managed databases that require TLS.
DB_SSL=
# Path to the provider's CA certificate (.pem) so the DB server cert is validated.
# Needed when the provider's CA isn't in the system trust store (e.g. Aiven — download
# the CA from its console). Leave unset if the provider uses a publicly-trusted CA.
DB_CA_CERT_PATH=
