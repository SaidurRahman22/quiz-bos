# Copy to .env and fill in your MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Quiz_boss
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: how long a login stays valid (default 7d)
JWT_EXPIRES_IN=7d

# Optional: restrict the API to your frontend origin (e.g. your Vercel URL).
# Leave unset to allow all origins.
CORS_ORIGIN=

# --- Cloud hosts (e.g. Railway) can instead provide a single connection URL ---
# DATABASE_URL=mysql://user:password@host:port/dbname
