# Frontend environment variables (Vite).
# Local development: leave this UNSET — requests to /api are proxied to the
# local Express server by vite.config.js.
#
# Production (Vercel): set this to your deployed backend URL, INCLUDING /api:
#   VITE_API_URL=https://your-backend.up.railway.app/api
# VITE_API_URL=
